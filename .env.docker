IMAGE_NAME=popchanskiy1998/testframework-runner:1.0

BACKEND_IMAGE=nobugsme/nbank:with_fraud_check
FRONTEND_IMAGE=nobugsme/nbank-ui:latest
NGINX_IMAGE=nginx:latest
POSTGRES_IMAGE=postgres:15-alpine
SELENIUM_HUB_IMAGE=selenium/hub:4.45.0-20260606
SELENIUM_CHROMIUM_IMAGE=selenium/node-chromium:4.45.0-20260606
SELENIUM_FIREFOX_IMAGE=selenium/node-firefox:4.45.0-20260606
WIREMOCK_IMAGE=wiremock/wiremock:3.9.1

PORT=4111
API_VERSION=1
APP_LOCAL_PORT=4111
FRONTEND_INTERNAL_PORT=80
NGINX_LOCAL_PORT=80
POSTGRES_LOCAL_PORT=5433
WIREMOCK_LOCAL_PORT=8080

DB_NAME=nbank
DB_USERNAME=postgres
DB_PASSWORD=postgres

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

HOST=http://backend
MOCK_REMOTE=http://wiremock:8080
REMOTE=http://selenium-hub:4444/wd/hub
BASE_URL=http://nginx
BROWSER=chromium
BROWSER_SIZE=1920x1080
TEST_GROUPS=API
